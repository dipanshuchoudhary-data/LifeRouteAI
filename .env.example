# LifeRoute AI - Environment Variables
# Copy this file to .env and fill in your values

# -- OpenRouter (LLM) --
# Uses the official `openrouter` Python SDK.
# Key:    https://openrouter.ai/keys
# Models: https://openrouter.ai/models
LLM_API_KEY=sk-or-v1-your-openrouter-key-here
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Omni / audio model for speech transcription (hero mic + assistant)
Voice_LLM=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Shown on the OpenRouter dashboard for app attribution
LLM_SITE_URL=http://localhost:5173
LLM_APP_NAME=LifeRoute

# -- App Config --
MOCK_MODE=false
# Set to true to skip live LLM calls — uses pre-computed demo results

# -- URLs --
# Local Vite: http://localhost:5173
# Docker / production website on port 80: http://localhost  (or https://your.domain)
FRONTEND_URL=http://localhost:5173
# Leave empty so the browser uses same-origin /api and /assistant.
# Vite (local) and nginx (production) reverse-proxy those paths to the API.
VITE_API_URL=
# Public origin of the website (used in the assistant OpenAPI spec)
ASSISTANT_CONNECTOR_URL=http://localhost:8000
# Extra CORS origins, comma-separated (production domain, etc.)
CORS_ORIGINS=
